BOT_TOKEN=توکن_ربات_تلگرام
ADMIN_IDS=123456789,987654321

# مسیر دیتابیس — روی Railway حتماً داخل Volume باشد
# Mount path ولوم: /app/data
DB_PATH=/app/data/bot.db

BASE_URL=https://khoshbakht-city.ir
PORT=8080

# ورود پنل با یوزرنیم/پسورد (اختیاری — کنار تلگرام)
PANEL_USER=admin
PANEL_PASSWORD=یک_پسورد_قوی
# اختیاری: user_id تلگرام که داده‌های پنل باهاش یکی باشه (پیش‌فرض: اولین ADMIN_IDS)
# PANEL_USER_ID=123456789

# سیستم جدید ورود با تلگرام (OpenID Connect)
# این دو مقدار را از بخش Login Widget داخل BotFather کپی کن
TELEGRAM_CLIENT_ID=8800121088
TELEGRAM_CLIENT_SECRET=xxxxx
